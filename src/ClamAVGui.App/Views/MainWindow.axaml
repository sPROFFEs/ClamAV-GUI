<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClamAVGui.App.ViewModels"
        xmlns:views="using:ClamAVGui.App.Views"
        x:Class="ClamAVGui.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Windows Security — ClamAV Protection Suite" Width="1180" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="280,*" RowDefinitions="*">
        <!-- Sidebar Navigation (Microsoft Defender Style) -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- App Title Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,16" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconShieldCheck}" Width="26" Height="26" Foreground="#107C10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Windows Security" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="ClamAV Antivirus Suite" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding SelectedTabIndex}"
                             Background="Transparent" SelectionMode="Single" Margin="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="28,*" Margin="4,2">
                                    <PathIcon Grid.Column="0" Data="{Binding IconResourceKey, Converter={x:Null}}"
                                              Width="16" Height="16" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Footer Status -->
                <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="6" Margin="12,16" Padding="12">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#107C10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Protection engine" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        </Grid>
                        <TextBlock Text="{Binding Dashboard.StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Toast Notification Banner -->
            <Border Grid.Row="0" Background="#1E293B" Padding="14,10" Margin="24,16,24,0" CornerRadius="6"
                    IsVisible="{Binding IsNotificationBannerVisible}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding NotificationBannerMessage}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissBannerCommand}" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="8,2" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Active View Switcher -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </TabControl.Styles>
                <TabItem>
                    <views:DashboardView DataContext="{Binding Dashboard}"/>
                </TabItem>
                <TabItem>
                    <views:ScanView DataContext="{Binding Scan}"/>
                </TabItem>
                <TabItem>
                    <views:UpdateView DataContext="{Binding Update}"/>
                </TabItem>
                <TabItem>
                    <views:HistoryView DataContext="{Binding History}"/>
                </TabItem>
                <TabItem>
                    <views:QuarantineView DataContext="{Binding Quarantine}"/>
                </TabItem>
                <TabItem>
                    <views:DaemonView DataContext="{Binding Daemon}"/>
                </TabItem>
                <TabItem>
                    <views:MonitoringView DataContext="{Binding Monitoring}"/>
                </TabItem>
                <TabItem>
                    <views:SchedulerView DataContext="{Binding Scheduler}"/>
                </TabItem>
                <TabItem>
                    <views:DiagnosticsView DataContext="{Binding Diagnostics}"/>
                </TabItem>
                <TabItem>
                    <views:SettingsView DataContext="{Binding Settings}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
