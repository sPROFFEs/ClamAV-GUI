<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClamAVGui.App.ViewModels"
        xmlns:views="using:ClamAVGui.App.Views"
        x:Class="ClamAVGui.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ClamAV Endpoint Security Suite" Width="1180" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">
        <!-- Collapsible Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0"
                Width="{Binding IsSidebarExpanded, Converter={StaticResource NullToBoolConverter}, FallbackValue=260}">
            <Border.Styles>
                <Style Selector="Border[Width=260]">
                    <Setter Property="Width" Value="260"/>
                </Style>
            </Border.Styles>
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- App Title and Hamburger Toggle -->
                <Border Grid.Row="0" Margin="16,20,16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconShieldCheck}" Width="24" Height="24" Foreground="#107C10" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}">
                            <TextBlock Text="ClamAV Security" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Endpoint Protection" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="defender-secondary" Content="☰" Command="{Binding ToggleSidebarCommand}"
                                Padding="8,4" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding SelectedTabIndex}"
                             Background="Transparent" SelectionMode="Single" Margin="6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="28,*" Margin="4,3">
                                    <PathIcon Grid.Column="0" Data="{Binding IconResourceKey, Converter={StaticResource ResourceNameToGeometryConverter}}"
                                              Width="16" Height="16" Opacity="0.85" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                               IsVisible="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).IsSidebarExpanded, x:CompileBindings=False}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Footer Status -->
                <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="6" Margin="10,14" Padding="10" IsVisible="{Binding IsSidebarExpanded}">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#107C10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ClamAV Core Engine" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        </Grid>
                        <TextBlock Text="{Binding Dashboard.StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Toast Notification Banner -->
            <Border Grid.Row="0" Background="#1E293B" Padding="14,10" Margin="24,16,24,0" CornerRadius="6"
                    IsVisible="{Binding IsNotificationBannerVisible}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding NotificationBannerMessage}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissBannerCommand}" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="8,2" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Active View Switcher -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </TabControl.Styles>
                <TabItem>
                    <views:DashboardView DataContext="{Binding Dashboard}"/>
                </TabItem>
                <TabItem>
                    <views:ScanView DataContext="{Binding Scan}"/>
                </TabItem>
                <TabItem>
                    <views:UpdateView DataContext="{Binding Update}"/>
                </TabItem>
                <TabItem>
                    <views:HistoryView DataContext="{Binding History}"/>
                </TabItem>
                <TabItem>
                    <views:QuarantineView DataContext="{Binding Quarantine}"/>
                </TabItem>
                <TabItem>
                    <views:DaemonView DataContext="{Binding Daemon}"/>
                </TabItem>
                <TabItem>
                    <views:MonitoringView DataContext="{Binding Monitoring}"/>
                </TabItem>
                <TabItem>
                    <views:SchedulerView DataContext="{Binding Scheduler}"/>
                </TabItem>
                <TabItem>
                    <views:DiagnosticsView DataContext="{Binding Diagnostics}"/>
                </TabItem>
                <TabItem>
                    <views:SettingsView DataContext="{Binding Settings}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
