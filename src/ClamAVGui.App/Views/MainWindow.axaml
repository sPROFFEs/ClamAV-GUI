<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClamAVGui.App.ViewModels"
        xmlns:views="using:ClamAVGui.App.Views"
        x:Class="ClamAVGui.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ClamAV Antivirus Suite" Width="1120" Height="780"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="250,*" RowDefinitions="*">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- App Logo & Title Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Background="#1E88E5" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="🛡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ClamAV Suite" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Endpoint Protection" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Navigation Links List -->
                <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding SelectedTabIndex}"
                             Background="Transparent" SelectionMode="Single" Margin="8,0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </ScrollViewer>

                <!-- Sidebar Status Footer -->
                <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8" Margin="12,16" Padding="12">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Background="#43A047" CornerRadius="5" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Engine Status" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                        </Grid>
                        <TextBlock Text="{Binding Dashboard.StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Toast Notification Banner -->
            <Border Grid.Row="0" Background="#263238" Padding="14,10" Margin="16,16,16,0" CornerRadius="8"
                    IsVisible="{Binding IsNotificationBannerVisible}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding NotificationBannerMessage}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissBannerCommand}" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="8,2" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Active View Switcher -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </TabControl.Styles>
                <TabItem>
                    <views:DashboardView DataContext="{Binding Dashboard}"/>
                </TabItem>
                <TabItem>
                    <views:ScanView DataContext="{Binding Scan}"/>
                </TabItem>
                <TabItem>
                    <views:UpdateView DataContext="{Binding Update}"/>
                </TabItem>
                <TabItem>
                    <views:HistoryView DataContext="{Binding History}"/>
                </TabItem>
                <TabItem>
                    <views:QuarantineView DataContext="{Binding Quarantine}"/>
                </TabItem>
                <TabItem>
                    <views:DaemonView DataContext="{Binding Daemon}"/>
                </TabItem>
                <TabItem>
                    <views:MonitoringView DataContext="{Binding Monitoring}"/>
                </TabItem>
                <TabItem>
                    <views:SchedulerView DataContext="{Binding Scheduler}"/>
                </TabItem>
                <TabItem>
                    <views:DiagnosticsView DataContext="{Binding Diagnostics}"/>
                </TabItem>
                <TabItem>
                    <views:SettingsView DataContext="{Binding Settings}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
