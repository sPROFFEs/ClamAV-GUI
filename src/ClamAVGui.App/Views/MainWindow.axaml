<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClamAVGui.App.ViewModels"
        xmlns:views="using:ClamAVGui.App.Views"
        x:Class="ClamAVGui.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ClamAV Security" Width="1240" Height="820"
        MinWidth="980" MinHeight="680"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="250,*">
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E6EAF0" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="24,28,20,26" Spacing="20">
                    <Grid ColumnDefinitions="42,*">
                        <Border Background="#E8F5F1" CornerRadius="12" Width="42" Height="42">
                            <TextBlock Text="✦" FontSize="25" Foreground="#087E68" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="ClamAV Security" FontSize="16" FontWeight="Bold" Foreground="#17212B"/>
                            <TextBlock Text="ENDPOINT PROTECTION" FontSize="9" FontWeight="SemiBold" Foreground="#7B8794"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="PROTECTION" FontSize="10" FontWeight="Bold" Foreground="#8995A2" Margin="4,4,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ListBox ItemsSource="{Binding NavItems}" SelectedIndex="{Binding SelectedTabIndex}"
                             Background="Transparent" BorderThickness="0" SelectionMode="Single" Margin="12,0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="14,11"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="#536170"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#E8F5F1"/>
                                <Setter Property="Foreground" Value="#087E68"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="10" Margin="16" Padding="14">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Width="8" Height="8" Fill="#20A477" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ClamAV engine" FontSize="12" FontWeight="SemiBold" Foreground="#293541" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding Dashboard.StatusText}" FontSize="11" Foreground="#71808E" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1" Padding="30,18">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Your device security" FontSize="13" Foreground="#71808E" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#F2F5F7" CornerRadius="16" Padding="11,6">
                        <TextBlock Text="CLAMAV PROTECTION" FontSize="10" FontWeight="Bold" Foreground="#536170"/>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#FFF4E5" BorderBrush="#F2D6A8" BorderThickness="1" Padding="14,10" Margin="24,18,24,0" CornerRadius="8"
                        IsVisible="{Binding IsNotificationBannerVisible}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding NotificationBannerMessage}" Foreground="#694B18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="×" Command="{Binding DismissBannerCommand}" Background="Transparent" Foreground="#694B18" Padding="8,2" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                    <views:DashboardView DataContext="{Binding Dashboard}"/>
                    <views:ScanView DataContext="{Binding Scan}"/>
                    <views:UpdateView DataContext="{Binding Update}"/>
                    <views:HistoryView DataContext="{Binding History}"/>
                    <views:QuarantineView DataContext="{Binding Quarantine}"/>
                    <views:DaemonView DataContext="{Binding Daemon}"/>
                    <views:MonitoringView DataContext="{Binding Monitoring}"/>
                    <views:SchedulerView DataContext="{Binding Scheduler}"/>
                    <views:DiagnosticsView DataContext="{Binding Diagnostics}"/>
                    <views:SettingsView DataContext="{Binding Settings}"/>
                </Carousel>
            </Grid>
        </Grid>
    </Grid>
</Window>
