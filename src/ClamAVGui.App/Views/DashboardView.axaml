<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer>
        <StackPanel Margin="36,30" Spacing="24" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Security at a glance" FontSize="27" FontWeight="Bold" Foreground="#17212B"/>
                <TextBlock Text="Review your protection status and take action when needed." FontSize="14" Foreground="#71808E"/>
            </StackPanel>

            <Border Background="#FFFFFF" BorderBrush="#E3E9ED" BorderThickness="1" CornerRadius="14" Padding="26">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Border Grid.RowSpan="3" Width="64" Height="64" CornerRadius="18" Background="#E8F5F1" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="✓" FontSize="34" FontWeight="SemiBold" Foreground="#087E68" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Protection status" FontSize="13" FontWeight="SemiBold" Foreground="#71808E"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding StatusText}" FontSize="21" FontWeight="Bold" Foreground="#17212B" Margin="0,3,0,4"/>
                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="#20A477" VerticalAlignment="Center"/>
                        <TextBlock Text="Definitions" FontSize="12" Foreground="#71808E"/>
                        <TextBlock Text="{Binding VirusDefinitionsVersion}" FontSize="12" FontWeight="SemiBold" Foreground="#425160"/>
                    </StackPanel>
                    <Button Grid.Column="2" Grid.RowSpan="3" Classes="primary" Command="{Binding StartScanCommand}" VerticalAlignment="Center" MinWidth="150">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="⌕" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Quick scan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Background="#FFF9EF" BorderBrush="#F1D7AC" BorderThickness="1" CornerRadius="12" Padding="18"
                    IsVisible="{Binding !IsClamAvConfigured}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#FFF0D4" Margin="0,0,13,0">
                        <TextBlock Text="!" FontSize="19" FontWeight="Bold" Foreground="#A66A12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Antivirus engine setup required" FontSize="14" FontWeight="Bold" Foreground="#604714"/>
                        <TextBlock Text="Install or configure ClamAV to scan files and enable protection." FontSize="12" Foreground="#7A6740" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Configure" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*">
                <Border Grid.Column="0" Classes="metric-card" Margin="0,0,8,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SCANS COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#84919D"/>
                        <TextBlock Text="{Binding TotalScans}" FontSize="29" FontWeight="Bold" Foreground="#17212B"/>
                        <TextBlock Text="All recorded scans" FontSize="11" Foreground="#84919D"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric-card" Margin="4,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="THREATS DETECTED" FontSize="10" FontWeight="Bold" Foreground="#84919D"/>
                        <TextBlock Text="{Binding TotalInfectedFiles}" FontSize="29" FontWeight="Bold" Foreground="#C34A46"/>
                        <TextBlock Text="Across scan history" FontSize="11" Foreground="#84919D"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric-card" Margin="8,0,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="LAST INTELLIGENCE UPDATE" FontSize="10" FontWeight="Bold" Foreground="#84919D"/>
                        <TextBlock Text="{Binding LastUpdateTime}" FontSize="17" FontWeight="Bold" Foreground="#17212B" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Check for updates" Command="{Binding UpdateDefinitionsCommand}" HorizontalAlignment="Left" Padding="0" Background="Transparent" Foreground="#087E68" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#FFFFFF" BorderBrush="#E3E9ED" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Engine status" FontSize="14" FontWeight="Bold" Foreground="#263440"/>
                        <TextBlock Text="{Binding DaemonStats}" FontSize="12" Foreground="#71808E"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh status" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
