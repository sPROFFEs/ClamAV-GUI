<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Page Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="Security at a glance" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="See what's happening with the security and health of your device and take any needed actions." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Alert Card when ClamAV is missing -->
            <Border Background="{DynamicResource DefenderDangerLight}" BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="8" Padding="20"
                    IsVisible="{Binding !IsClamAvConfigured}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconWarning}" Width="28" Height="28" Foreground="#C42B1C" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="ClamAV engine is not configured" FontWeight="Bold" FontSize="15" Foreground="#C42B1C"/>
                        <TextBlock Text="To enable virus scanning and real-time defense, install or link the ClamAV backend." FontSize="12" Foreground="#333333"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="defender-primary" Content="Set up engine" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Hero Status Banner (Defender Style) -->
            <Border Classes="defender-card" Padding="22">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <PathIcon Grid.Column="0" Grid.RowSpan="3" Data="{StaticResource IconShieldCheck}" Width="44" Height="44" Foreground="#107C10" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <TextBlock Grid.Column="1" Grid.Row="0" Text="No current threats" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Virus &amp; threat protection is active and keeping your files safe." FontSize="13" Opacity="0.75" Margin="0,4,0,10"/>

                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding TotalScans, StringFormat='Total scans run: {0}'}" FontSize="12" Opacity="0.7"/>
                        <TextBlock Text="•" Opacity="0.4"/>
                        <TextBlock Text="{Binding LastUpdateTime, StringFormat='Last update: {0}'}" FontSize="12" Opacity="0.7"/>
                        <TextBlock Text="•" Opacity="0.4"/>
                        <TextBlock Text="{Binding VirusDefinitionsVersion, StringFormat='Intelligence: {0}'}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Defender Feature Tiles Grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                <!-- Tile 1: Virus & Threat Protection -->
                <Border Grid.Column="0" Grid.Row="0" Classes="action-tile" Margin="0,0,10,16">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconScan}" Width="24" Height="24" Foreground="#0067C0" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Virus &amp; threat protection" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Scan files and folders on demand for viruses, spyware, and emerging malware." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="defender-primary" Content="Quick scan" Command="{Binding StartScanCommand}"/>
                                <Button Classes="defender-secondary" Content="Scan options" Command="{Binding StartScanCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tile 2: Security Intelligence -->
                <Border Grid.Column="1" Grid.Row="0" Classes="action-tile" Margin="10,0,0,16">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconUpdates}" Width="24" Height="24" Foreground="#0067C0" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Security intelligence updates" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Check for the latest virus definitions and engine database signatures." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="defender-secondary" Content="Check for updates" Command="{Binding UpdateDefinitionsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tile 3: Real-Time Protection -->
                <Border Grid.Column="0" Grid.Row="1" Classes="action-tile" Margin="0,0,10,0">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconMonitoring}" Width="24" Height="24" Foreground="#0067C0" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Real-time monitoring" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Monitors specified directories and automatically inspects new or altered files." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="defender-secondary" Content="Configure monitoring" Command="{Binding OpenSettingsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tile 4: ClamAV Daemon Engine -->
                <Border Grid.Column="1" Grid.Row="1" Classes="action-tile" Margin="10,0,0,0">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconDaemon}" Width="24" Height="24" Foreground="#0067C0" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Daemon &amp; background service" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="High-speed memory resident scanner providing fast multi-threaded scanning." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="defender-secondary" Content="Manage service" Command="{Binding OpenSettingsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
