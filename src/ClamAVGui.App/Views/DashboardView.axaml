<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Protection overview" FontSize="28" FontWeight="SemiBold"/>

            <Border Classes="clamav-card" Padding="22">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{StaticResource IconShield}" Width="32" Height="32"
                              Foreground="{StaticResource ClamAvRedHover}" VerticalAlignment="Top" Margin="0,4,18,0"/>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding StatusText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <SelectableTextBlock Text="{Binding DatabaseDirectory}" TextWrapping="Wrap" Opacity="0.75"
                                             IsVisible="{Binding DatabaseDirectory, Converter={StaticResource NullToBoolConverter}}"/>
                        <TextBlock Text="{Binding TotalScans, StringFormat='Completed scans: {0}'}" FontSize="12" Opacity="0.75"/>
                        <TextBlock Text="{Binding LastUpdateTime, StringFormat='Last confirmed online check: {0}'}" FontSize="12" Opacity="0.75"/>
                        <Button Classes="clamav-secondary" Content="Configure ClamAV" Command="{Binding OpenSettingsCommand}"
                                IsVisible="{Binding !IsDatabaseReady}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Feature Tiles Grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                <!-- Tile 1: Virus & Threat Protection -->
                <Border Grid.Column="0" Grid.Row="0" Classes="action-tile" Margin="0,0,10,16">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconScan}" Width="24" Height="24" Foreground="#C41E3A" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Antivirus Scanner" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Scan files, directories, and archives on demand with heuristic analysis." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="clamav-primary" Content="Scan files" Command="{Binding StartScanCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tile 2: Security Intelligence -->
                <Border Grid.Column="1" Grid.Row="0" Classes="action-tile" Margin="10,0,0,16">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconUpdates}" Width="24" Height="24" Foreground="#C41E3A" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Signature updates" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Update online with FreshClam. Offline databases can be configured in Settings." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="clamav-secondary" Content="Update signatures" Command="{Binding UpdateDefinitionsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tile 3: Real-Time Protection -->
                <Border Grid.Column="0" Grid.Row="1" Classes="action-tile" Margin="0,0,10,0">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconMonitoring}" Width="24" Height="24" Foreground="#C41E3A" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Folder monitoring" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Scan new and changed files in folders you choose." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="clamav-secondary" Content="Configure monitoring" Command="{Binding OpenMonitoringCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tile 4: ClamAV Daemon Engine -->
                <Border Grid.Column="1" Grid.Row="1" Classes="action-tile" Margin="10,0,0,0">
                    <DockPanel>
                        <PathIcon DockPanel.Dock="Left" Data="{StaticResource IconDaemon}" Width="24" Height="24" Foreground="#C41E3A" VerticalAlignment="Top" Margin="0,2,14,0"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="ClamAV daemon" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="View the status of the optional ClamAV background service." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="clamav-secondary" Content="Daemon controls" Command="{Binding OpenDaemonCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
