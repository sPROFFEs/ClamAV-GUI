<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.MonitoringView"
             x:DataType="vm:MonitoringViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Real-Time File Protection" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Scans files on creation or modification inside watched directories." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Toggle Banner -->
            <Border Classes="clamav-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Real-Time Directory Watcher" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Monitors specified directories and initiates background scans for altered files." FontSize="12" Opacity="0.75"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMonitoringActive}" Command="{Binding ToggleMonitoringCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Actions Bar -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="clamav-secondary" Content="📁 Add Folder to Watch" Command="{Binding AddMonitoredFolderCommand}"/>
                <Button Classes="clamav-secondary" Content="🚫 Add Exclusion" Command="{Binding AddExcludedFolderCommand}"/>
                <Button Classes="clamav-secondary" Content="📥 Export Activity Log" Command="{Binding ExportLogCommand}"/>
            </StackPanel>

            <!-- Folders and Exclusions Grid -->
            <Grid ColumnDefinitions="*,*">
                <!-- Monitored Paths -->
                <Border Grid.Column="0" Classes="clamav-card" Padding="0" Margin="0,0,10,0" MinHeight="180">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                            <TextBlock Text="Watched Directories" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Spacing="6" IsVisible="{Binding !MonitoredPaths.Count}">
                            <PathIcon Data="{StaticResource IconMonitoring}" Width="32" Height="32" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="No directories added. Click 'Add Folder to Watch'." Opacity="0.5" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding MonitoredPaths}" Background="Transparent" IsVisible="{Binding MonitoredPaths.Count}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="clamav-secondary" Content="Remove"
                                                Click="OnRemoveMonitoredClick"
                                                Tag="{Binding}"
                                                Padding="6,2" FontSize="10" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Excluded Paths -->
                <Border Grid.Column="1" Classes="clamav-card" Padding="0" Margin="10,0,0,0" MinHeight="180">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                            <TextBlock Text="Exclusions" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Spacing="6" IsVisible="{Binding !ExcludedPaths.Count}">
                            <PathIcon Data="{StaticResource IconShield}" Width="32" Height="32" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="No exclusion rules configured." Opacity="0.5" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ExcludedPaths}" Background="Transparent" IsVisible="{Binding ExcludedPaths.Count}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="clamav-secondary" Content="Remove"
                                                Click="OnRemoveExcludedClick"
                                                Tag="{Binding}"
                                                Padding="6,2" FontSize="10" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Activity Stream -->
            <Border Classes="clamav-card" Padding="0" MinHeight="180">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="Live Monitoring Event Stream" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                    </Border>
                    <ScrollViewer MaxHeight="240" Margin="16">
                        <Panel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Spacing="6" IsVisible="{Binding !LogEntries.Count}">
                                <PathIcon Data="{StaticResource IconMonitoring}" Width="32" Height="32" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.4" HorizontalAlignment="Center" />
                                <TextBlock Text="No activity. Enable monitoring to start logging events." Opacity="0.5" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" IsVisible="{Binding LogEntries.Count}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11" Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
