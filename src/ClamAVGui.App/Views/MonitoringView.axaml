<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.MonitoringView"
             x:DataType="vm:MonitoringViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Real-time protection" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Locates and stops malware from running or altering files on your device." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Toggle Banner -->
            <Border Classes="defender-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Real-time file monitoring" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Scans files on creation or modification inside watched directories." FontSize="12" Opacity="0.75"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMonitoringActive}" Command="{Binding ToggleMonitoringCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Actions Bar -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="defender-secondary" Content="Add folder to monitor" Command="{Binding AddMonitoredFolderCommand}"/>
                <Button Classes="defender-secondary" Content="Add exclusion" Command="{Binding AddExcludedFolderCommand}"/>
                <Button Classes="defender-secondary" Content="Export activity log" Command="{Binding ExportLogCommand}"/>
            </StackPanel>

            <!-- Folders and Exclusions Grid -->
            <Grid ColumnDefinitions="*,*">
                <!-- Monitored Paths -->
                <Border Grid.Column="0" Classes="defender-card" Padding="0" Margin="0,0,10,0" MinHeight="180">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                            <TextBlock Text="Monitored directories" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                        </Border>
                        <TextBlock Text="No directories added. Click 'Add folder to monitor'."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.5" FontSize="12" Margin="16" IsVisible="{Binding !MonitoredPaths.Count}"/>
                        <ListBox ItemsSource="{Binding MonitoredPaths}" Background="Transparent" IsVisible="{Binding MonitoredPaths.Count}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="defender-secondary" Content="Remove"
                                                Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).RemoveMonitoredFolderCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" FontSize="10" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Excluded Paths -->
                <Border Grid.Column="1" Classes="defender-card" Padding="0" Margin="10,0,0,0" MinHeight="180">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                            <TextBlock Text="Exclusions" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                        </Border>
                        <TextBlock Text="No exclusion rules configured."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.5" FontSize="12" Margin="16" IsVisible="{Binding !ExcludedPaths.Count}"/>
                        <ListBox ItemsSource="{Binding ExcludedPaths}" Background="Transparent" IsVisible="{Binding ExcludedPaths.Count}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="defender-secondary" Content="Remove"
                                                Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).RemoveExcludedFolderCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" FontSize="10" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Activity Stream -->
            <Border Classes="defender-card" Padding="0" MinHeight="180">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="Live monitoring event stream" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                    </Border>
                    <ScrollViewer MaxHeight="240" Margin="16">
                        <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
