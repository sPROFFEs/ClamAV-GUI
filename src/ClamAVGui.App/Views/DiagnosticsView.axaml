<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="System &amp; Engine Diagnostics" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Inspect ClamAV engine binary locations, service socket bindings, and generate diagnostic reports." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Actions Bar -->
            <Border Classes="clamav-card" Padding="14">
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="clamav-primary" Content="🩺 Run Health Check" Command="{Binding RefreshReportCommand}" Margin="0,0,10,6"/>
                    <Button Classes="clamav-secondary" Content="📋 Copy Redacted Report" Command="{Binding CopyRedactedReportCommand}" Margin="0,0,10,6"/>
                    <Button Classes="clamav-secondary" Content="📋 Copy Full Report" Command="{Binding CopyFullReportCommand}" Margin="0,0,10,6"/>
                </WrapPanel>
            </Border>

            <!-- Report Output Card -->
            <Border Classes="clamav-card" Padding="0" MinHeight="260">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="Diagnostic Report Details" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                    </Border>
                    <ScrollViewer MaxHeight="400" Margin="16">
                        <Panel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" Spacing="10" IsVisible="{Binding Report, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Invert}">
                                <PathIcon Data="{StaticResource IconDiagnostics}" Width="48" Height="48" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Text="No diagnostics run yet. Click 'Run Health Check' to generate a report."
                                           Opacity="0.5" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding FormattedReport}" IsReadOnly="true" FontFamily="Monospace" FontSize="12" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" IsVisible="{Binding Report, Converter={StaticResource NullToBoolConverter}}"/>
                        </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Height="4"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
