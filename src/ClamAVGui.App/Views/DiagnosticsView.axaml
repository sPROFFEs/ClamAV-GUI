<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="System &amp; engine diagnostics" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Inspect ClamAV engine binary locations, service socket bindings, and generate diagnostic reports." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Actions Bar -->
            <Border Classes="defender-card" Padding="14">
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="defender-primary" Content="Run health check" Command="{Binding RefreshReportCommand}" Margin="0,0,10,6"/>
                    <Button Classes="defender-secondary" Content="Copy redacted report" Command="{Binding CopyRedactedReportCommand}" Margin="0,0,10,6"/>
                    <Button Classes="defender-secondary" Content="Copy full report" Command="{Binding CopyFullReportCommand}" Margin="0,0,10,6"/>
                </WrapPanel>
            </Border>

            <!-- Report Output Card -->
            <Border Classes="defender-card" Padding="0" MinHeight="260">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                        <TextBlock Text="Diagnostic report details" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                    </Border>
                    <ScrollViewer MaxHeight="400" Margin="16">
                        <TextBox Text="{Binding FormattedReport}" IsReadOnly="true" FontFamily="Monospace" FontSize="12" Background="Transparent" BorderThickness="0" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Height="4"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
