<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             x:Class="ClamAVGui.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings &amp; Engine Management" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Manage settings for ClamAV engine integration, software updates, and scanning behavior." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Card: Application Software Updates -->
            <Border Classes="clamav-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="ClamAV GUI Software Updates" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding CurrentAppVersion, StringFormat='Installed application version: {0}'}" FontSize="12" Opacity="0.75"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="clamav-primary" Content="Check for GUI updates" Command="{Binding CheckAppUpdatesCommand}" IsEnabled="{Binding !IsCheckingAppUpdates}"/>
                    </Grid>

                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="6" Padding="12"
                            IsVisible="{Binding AvailableAppRelease, Converter={StaticResource NullToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding AvailableAppRelease.TagName, StringFormat='Update available: {0}'}" FontWeight="Bold" FontSize="14" Foreground="#C41E3A"/>
                                <TextBlock Text="A newer version of ClamAV GUI is ready to install from GitHub." FontSize="12" Opacity="0.8"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="clamav-primary" Content="Update &amp; Restart" Command="{Binding ApplyAppUpdateCommand}" Padding="14,8"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding AppUpdateStatusMessage}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding AppUpdateStatusMessage, Converter={StaticResource NullToBoolConverter}}"/>
                    <ProgressBar IsIndeterminate="{Binding IsCheckingAppUpdates}" IsVisible="{Binding IsCheckingAppUpdates}" Height="4"/>
                </StackPanel>
            </Border>

            <!-- Card 1: Engine Installation Helper -->
            <Border Classes="clamav-card" BorderBrush="#C41E3A" BorderThickness="1.5">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="ClamAV Engine Installation" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Install and set up the ClamAV antivirus backend automatically for your operating system." FontSize="12" Opacity="0.75"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="clamav-primary" Content="Install ClamAV engine" Command="{Binding InstallEngineCommand}" IsEnabled="{Binding !IsInstallingEngine}"/>
                    </Grid>

                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Recommended system command / setup method:" FontWeight="SemiBold" FontSize="11" Opacity="0.7"/>
                            <TextBox Text="{Binding RecommendedInstallCommand}" IsReadOnly="true" FontFamily="Monospace" FontSize="11" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4" IsVisible="{Binding EngineInstallStatus, Converter={StaticResource NullToBoolConverter}}">
                        <TextBlock Text="{Binding EngineInstallStatus}" FontWeight="SemiBold" FontSize="12"/>
                        <ProgressBar IsIndeterminate="{Binding IsInstallingEngine}" IsVisible="{Binding IsInstallingEngine}" Height="4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Binary & Quarantine Paths -->
            <Border Classes="clamav-card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Engine and Storage Directories" FontWeight="SemiBold" FontSize="16"/>
                        <Button Grid.Column="1" Classes="clamav-secondary" Content="🔍 Auto-detect paths" Command="{Binding AutoDetectClamAvCommand}"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="ClamAV binary directory (Leave blank to use system PATH)" FontSize="12" Opacity="0.8"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding CustomClamAvPath}" Watermark="e.g. /usr/bin, /opt/homebrew/bin, or C:\Program Files\ClamAV" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Classes="clamav-secondary" Content="Browse..." Command="{Binding BrowseClamAvPathCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Custom quarantine vault folder (Optional)" FontSize="12" Opacity="0.8"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding CustomQuarantinePath}" Watermark="Default application data folder" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Classes="clamav-secondary" Content="Browse..." Command="{Binding BrowseQuarantinePathCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Scanning Options -->
            <Border Classes="clamav-card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Threat Scanning Preferences" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox Content="Enable heuristic detection alerts (--heuristic-alerts=yes)" IsChecked="{Binding HeuristicAlerts}"/>
                    <CheckBox Content="Alert on encrypted archives (--alert-encrypted=yes)" IsChecked="{Binding ScanEncrypted}"/>
                    <CheckBox Content="Move infected items directly to quarantine vault" IsChecked="{Binding MoveToQuarantine}"/>
                    <CheckBox Content="Retain temporary unpacked analysis files (--leave-temps=yes)" IsChecked="{Binding LeaveTemps}"/>
                </StackPanel>
            </Border>

            <!-- Card 4: System Integration -->
            <Border Classes="clamav-card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Startup and Window Behavior" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox Content="Start ClamAV GUI automatically upon system login" IsChecked="{Binding StartOnLogin}"/>
                    <CheckBox Content="Minimize application to system tray on window close" IsChecked="{Binding MinimizeToTray}"/>
                </StackPanel>
            </Border>

            <!-- Save Actions -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="clamav-primary" Content="💾 Save Settings" Command="{Binding SaveSettingsCommand}"/>
                <Button Classes="clamav-secondary" Content="🔄 Reload Settings" Command="{Binding LoadSettingsCommand}"/>
            </StackPanel>

            <Border Classes="clamav-card" IsVisible="{Binding StatusMessage, Converter={StaticResource NullToBoolConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
