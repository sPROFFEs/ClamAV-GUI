<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             xmlns:models="using:ClamAVGui.Core.Models"
             x:Class="ClamAVGui.App.Views.QuarantineView"
             x:DataType="vm:QuarantineViewModel">
    <Grid Margin="28,24" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Quarantine Vault" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Isolated threats stored safely. You can inspect, restore, or permanently delete items." Opacity="0.7"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12" Spacing="10">
            <Button Content="🔄 Refresh Vault" Command="{Binding LoadCommand}" Padding="14,8"/>
        </StackPanel>

        <!-- Quarantine Table -->
        <Border Grid.Row="2" Classes="card" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="12,8" CornerRadius="8,8,0,0">
                    <Grid ColumnDefinitions="*,180,110,140,Auto">
                        <TextBlock Grid.Column="0" Text="Original File Location &amp; Threat" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Date Quarantined" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Integrity SHA-256" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="Actions" FontWeight="SemiBold" FontSize="12" Margin="10,0"/>
                    </Grid>
                </Border>

                <!-- Empty State -->
                <TextBlock Text="Quarantine vault is empty. No threats are currently quarantined."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.5" FontSize="13" Margin="20"
                           IsVisible="{Binding !Items.Count}"/>

                <ListBox ItemsSource="{Binding Items}" Background="Transparent" IsVisible="{Binding Items.Count}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:QuarantineItem">
                            <Grid ColumnDefinitions="*,180,110,140,Auto" Margin="0,6">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding OriginalPath}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ThreatName, StringFormat='Threat: {0}'}" Foreground="#E53935" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding QuarantinedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Opacity="0.75" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding FileHashSha256}" TextTrimming="CharacterEllipsis" FontFamily="Monospace" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Content="Restore"
                                            Command="{Binding $parent[UserControl].((vm:QuarantineViewModel)DataContext).RestoreItemCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4" FontSize="11"/>
                                    <Button Classes="danger" Content="Delete"
                                            Command="{Binding $parent[UserControl].((vm:QuarantineViewModel)DataContext).DeleteItemCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Files in quarantine cannot execute and are stored with cryptographic verification." Opacity="0.6" FontSize="11" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
