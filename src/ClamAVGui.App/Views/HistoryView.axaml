<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClamAVGui.App.ViewModels"
             xmlns:views="using:ClamAVGui.App.Views"
             xmlns:models="using:ClamAVGui.Core.Models"
             x:Class="ClamAVGui.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <ScrollViewer Margin="36,28">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Protection history" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="View security recommendations, scan events, and actions taken on potential threats." FontSize="13" Opacity="0.7"/>
            </StackPanel>

            <!-- Search and Filter Bar -->
            <Border Classes="clamav-card" Padding="14">
                <Grid ColumnDefinitions="*,180,Auto,Auto,Auto">
                    <TextBox Grid.Column="0" Text="{Binding FilterText}" Watermark="Filter history items..." Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding FilterType}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Classes="clamav-secondary" Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Classes="clamav-secondary" Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0"/>
                    <Button Grid.Column="4" Classes="clamav-danger" Content="Clear all" Command="{Binding ClearHistoryCommand}"/>
                </Grid>
            </Border>

            <!-- History Items Table -->
            <Border Classes="clamav-card" Padding="0" MinHeight="250">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                        <Grid ColumnDefinitions="160,120,*,Auto">
                            <TextBlock Grid.Column="0" Text="Date and time (UTC)" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                            <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                            <TextBlock Grid.Column="2" Text="Event details" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                            <TextBlock Grid.Column="3" Text="Action" FontWeight="SemiBold" FontSize="12" Opacity="0.8" Margin="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <TextBlock Text="No security actions or events found in protection history."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.5" FontSize="13" Margin="30"
                               IsVisible="{Binding !Events.Count}"/>

                    <ListBox ItemsSource="{Binding Events}" Background="Transparent" IsVisible="{Binding Events.Count}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryEvent">
                                <Grid ColumnDefinitions="160,120,*,Auto" Margin="8,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Opacity="0.75" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding EventType, Converter={StaticResource EventTypeToBrushConverter}}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EventType}" Foreground="White" FontWeight="SemiBold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Details}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Classes="clamav-secondary" Content="Delete"
                                            Click="OnDeleteClick"
                                            Tag="{Binding}"
                                            Padding="8,4" FontSize="11" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
